# API and Database Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Neon Serverless Postgres (Primary KB)
# Format: postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=qdrant_key

# LLM Judge
JUDGE_MODEL=claude-3-opus
OPENAI_API_KEY=your-api-key-here

# Trust Score Weights (Stage 4)
TRUST_WEIGHT_W1=0.3
TRUST_WEIGHT_W2=0.4
TRUST_WEIGHT_W3=0.3

# Decision Thresholds
GAMMA_THRESHOLD=0.5
GAMMA_CRITICAL=0.8

# Fallback Search (External APIs)
INDIAN_KANOON_API_KEY=your_indian_kanoon_token_here
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_ID=your_google_cse_search_engine_id_here

# Logging
LOG_LEVEL=INFO
